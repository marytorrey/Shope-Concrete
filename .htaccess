<IfModule mod_rewrite.c>
RewriteEngine On

# 301 Redirects for legacy HTML pages (priority over general HTTPS/non-www enforcement)
RewriteRule ^html/com_overview\.html$ https://shopeconcrete.com/about.php [L,R=301]
RewriteRule ^html/cat_catchbasins\.html$ https://shopeconcrete.com/catalog2.php [L,R=301]
RewriteRule ^html/cat_areadrains\.html$ https://shopeconcrete.com/catalog1.php [L,R=301]
RewriteRule ^html/home\.html$ https://shopeconcrete.com/index.php [L,R=301]

# Force HTTPS + non-www for all other pages
RewriteCond %{HTTP_HOST} ^www\.shopeconcrete\.com$ [NC]
RewriteRule ^(.*)$ https://shopeconcrete.com/ [L,R=301]

RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://shopeconcrete.com/ [L,R=301]

</IfModule>

<IfModule mod_headers.c>
Header always set Content-Security-Policy "upgrade-insecure-requests;"
</IfModule>
