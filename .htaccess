<IfModule mod_rewrite.c>
RewriteEngine On

# Redirect legacy HTML pages to PHP equivalents
RewriteRule ^html/home\.html$ https://shopeconcrete.com/ [L,R=301]
RewriteRule ^html/home_phones\ down\.html$ https://shopeconcrete.com/ [L,R=301]
RewriteRule ^html/home_phones%20down\.html$ https://shopeconcrete.com/ [L,R=301]

RewriteRule ^html/com_overview\.html$ https://shopeconcrete.com/about.php [L,R=301]
RewriteRule ^html/com_policies\.html$ https://shopeconcrete.com/about.php [L,R=301]
RewriteRule ^html/com_profile_erik\.html$ https://shopeconcrete.com/about.php [L,R=301]
RewriteRule ^html/com_profile_gpattee\.html$ https://shopeconcrete.com/about.php [L,R=301]
RewriteRule ^html/com_profile_james_b\.html$ https://shopeconcrete.com/about.php [L,R=301]
RewriteRule ^html/com_profile_john_p\.html$ https://shopeconcrete.com/about.php [L,R=301]
RewriteRule ^html/com_profile_rwilde\.html$ https://shopeconcrete.com/about.php [L,R=301]
RewriteRule ^html/com_profile_steve\.html$ https://shopeconcrete.com/about.php [L,R=301]

RewriteRule ^html/cat_catchbasins\.html$ https://shopeconcrete.com/catalog2.php [L,R=301]
RewriteRule ^html/cat_areadrains\.html$ https://shopeconcrete.com/catalog2.php [L,R=301]
RewriteRule ^html/cat_conv_tools\.html$ https://shopeconcrete.com/startercat.php [L,R=301]

# Force HTTPS + non-www for shopeconcrete.com
RewriteCond %{HTTP_HOST} ^www\.shopeconcrete\.com$ [NC,OR]
RewriteCond %{HTTPS} off
RewriteRule ^ https://shopeconcrete.com%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
Header always set Content-Security-Policy "upgrade-insecure-requests;"
</IfModule>
